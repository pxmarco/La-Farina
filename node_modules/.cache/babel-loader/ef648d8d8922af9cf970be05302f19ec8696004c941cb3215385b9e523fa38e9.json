{"ast":null,"code":"export default {\n  name: \"AlertaComponent\",\n  props: {\n    tipo: {\n      type: String,\n      default: \"info\"\n    },\n    mensagem: {\n      type: String,\n      default: \"\"\n    }\n  },\n  computed: {\n    icone() {\n      const icones = {\n        erro: \"!\",\n        aviso: \"i\",\n        info: \"?\",\n        sucesso: \"+\"\n      };\n      return icones[this.tipo] || icones.info;\n    }\n  }\n};","map":{"version":3,"names":["name","props","tipo","type","String","default","mensagem","computed","icone","icones","erro","aviso","info","sucesso"],"sources":["/Users/usuario1/Documents/GitHub/tpizza-artesanal/src/components/AlertaComponent.vue"],"sourcesContent":["<template>\n  <div v-if=\"mensagem\" class=\"alerta\" :class=\"tipo\">\n    <span class=\"alerta-icone\">{{ icone }}</span>\n    <span>{{ mensagem }}</span>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"AlertaComponent\",\n  props: {\n    tipo: {\n      type: String,\n      default: \"info\",\n    },\n    mensagem: {\n      type: String,\n      default: \"\",\n    },\n  },\n  computed: {\n    icone() {\n      const icones = {\n        erro: \"!\",\n        aviso: \"i\",\n        info: \"?\",\n        sucesso: \"+\",\n      };\n\n      return icones[this.tipo] || icones.info;\n    },\n  },\n};\n</script>\n\n<style scoped>\n.alerta {\n  width: min(720px, calc(100% - 32px));\n  margin: 16px auto;\n  padding: 14px 18px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-weight: bold;\n  text-align: left;\n  border-left: 6px solid;\n}\n\n.alerta-icone {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: white;\n  flex-shrink: 0;\n}\n\n.erro {\n  color: #7f1d1d;\n  background: #fee2e2;\n  border-color: #dc2626;\n}\n\n.erro .alerta-icone {\n  background: #dc2626;\n}\n\n.aviso {\n  color: #7c2d12;\n  background: #ffedd5;\n  border-color: #f97316;\n}\n\n.aviso .alerta-icone {\n  background: #f97316;\n}\n\n.info {\n  color: #1e3a8a;\n  background: #dbeafe;\n  border-color: #2563eb;\n}\n\n.info .alerta-icone {\n  background: #2563eb;\n}\n\n.sucesso {\n  color: #14532d;\n  background: #dcfce7;\n  border-color: #16a34a;\n}\n\n.sucesso .alerta-icone {\n  background: #16a34a;\n}\n</style>\n"],"mappings":"AAQA,eAAe;EACbA,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EACDE,QAAQ,EAAE;IACRC,KAAKA,CAAA,EAAG;MACN,MAAMC,MAAK,GAAI;QACbC,IAAI,EAAE,GAAG;QACTC,KAAK,EAAE,GAAG;QACVC,IAAI,EAAE,GAAG;QACTC,OAAO,EAAE;MACX,CAAC;MAED,OAAOJ,MAAM,CAAC,IAAI,CAACP,IAAI,KAAKO,MAAM,CAACG,IAAI;IACzC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}