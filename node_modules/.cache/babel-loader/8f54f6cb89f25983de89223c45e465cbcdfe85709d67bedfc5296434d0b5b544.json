n  margin: 0 0 10px;\n}\n\n.foto-pizza {\n  width: 100%;\n  height: 200px;\n  object-fit: cover;\n}\n\n#preco-content {\n  font-size: 35px;\n  font-weight: bold;\n  text-align: center;\n  color: #15803d;\n  margin: 0 0 10px;\n}\n\n#descricao-content {\n  font-size: 16px;\n  text-align: left;\n  color: #555;\n  margin: 0 0 18px;\n  white-space: pre-line;\n  text-overflow: ellipsis;\n  overflow: hidden;\n  display: -webkit-box;\n  -webkit-line-clamp: 6;\n  -webkit-box-orient: vertical;\n}\n\n.card-coluna {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: 15px;\n}\n\n.card-coluna button {\n  margin-top: auto;\n  padding: 10px;\n  width: 100%;\n  border-radius: 8px;\n  border: none;\n  color: white;\n  background-color: #15803d;\n  cursor: pointer;\n  transition: 0.5s;\n}\n\n.card-coluna button:hover {\n  color: rgb(202, 246, 202);\n  background-color: #14532d;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAW;;EAEfC,EAAE,EAAC;AAAgB;;;EAGfD,KAAK,EAAC;AAAa;;EACnBC,EAAE,EAAC;AAAc;;EACjBA,EAAE,EAAC;AAAe;;EAClBA,EAAE,EAAC;AAAmB;;;uBARjCC,mBAAA,CAaM,OAbNC,UAaM,G,0BAZJC,mBAAA,CAAiB,YAAb,UAAQ,qBACZA,mBAAA,CAUM,OAVNC,UAUM,I,kBATJH,mBAAA,CAQMI,SAAA,QAAAC,WAAA,CARiCC,KAAA,CAAAC,eAAe,EAAxBC,KAAK;yBAAnCR,mBAAA,CAQM;MARDD,EAAE,EAAC,cAAc;MAAmCU,GAAG,EAAED,KAAK,CAACT;QAClEG,mBAAA,CAA4C;MAAvCJ,KAAK,EAAC,YAAY;MAAEY,GAAG,EAAEF,KAAK,CAACG;yCACpCT,mBAAA,CAKM,OALNU,UAKM,GAJJV,mBAAA,CAAyC,KAAzCW,UAAyC,EAAAC,gBAAA,CAAjBN,KAAK,CAACO,IAAI,kBAClCb,mBAAA,CAAiD,KAAjDc,UAAiD,EAA3B,KAAG,GAAAF,gBAAA,CAAGN,KAAK,CAACS,KAAK,IAAG,KAAG,iBAC7Cf,mBAAA,CAAmD,KAAnDgB,UAAmD,EAAAJ,gBAAA,CAAtBN,KAAK,CAACW,SAAS,kBAC5CjB,mBAAA,CAA2D;MAAlDkB,OAAK,EAAAC,MAAA,IAAEC,QAAA,CAAAC,eAAe,CAACf,KAAK;OAAG,YAAU,iBAAAgB,UAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}